# agent.py
from typing import List, Optional, Dict, Any, TypedDict
from typing_extensions import TypedDict
from langgraph.graph import END, StateGraph
from app.controllers import set_config_location
from app.integrations.gemini_integration import GeminiEmbeddings, GeminiLLM
from app.integrations.llamaintegration import LlamaEmbeddings, LlamaLLm
from app.controllers.llmfactory import LLMFactory
from app.chat.history.chat_history import get_chat_history, add_to_chat_history
import yaml
import logging

# Configure logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Load config
CONFIG_PATH = "config/llm.yaml"
config = set_config_location()

with open(CONFIG_PATH, "r", encoding="utf-8") as file:
    model_config = yaml.safe_load(file)

class GraphState(TypedDict):
    question: Optional[str]
    user_id: Optional[str]
    conversation_id: Optional[str]
    classification: Optional[str]
    response: Optional[str]
    retrieved_docs: Optional[List[str]]
    vector_search_results: Optional[List[str]]
    llm_output: Optional[str]
    web_search_results: Optional[str]
    reference: Optional[str]
    model: Optional[str]

# Initialize workflow
workflow = StateGraph(GraphState)

def classify_query(state: GraphState) -> GraphState:
    try:
        conv_id = state["conversation_id"]
        query = state["question"]
        history = get_chat_history(conv_id)
        
        # Enhanced query with history context
        history_context = "\n".join([f"User: {h['user']}\nAgent: {h['agent']}" for h in history[-3:]])
        enhanced_query = f"{query}\n\nContext:\n{history_context}"
        
        # JIRA detection
        jira_details = LangGraphAgentHandler.extract_jira_pattern(enhanced_query)
        if jira_details:
            add_to_chat_history(conv_id, query, "JIRA pattern detected")
            return {"classification": "jira_code_generation", **state}
        
        # Intent detection
        intent = LangGraphAgentHandler.detect_intent(
            enhanced_query, 
            history,
            model_config[state["model"]]
        )
        if intent == 'code_generation':
            add_to_chat_history(conv_id, query, "Code generation detected")
            return {"classification": "code_generation", **state}
        
        # Fallback routing with error handling
        try:
            route = embeddings.history_aware_router(enhanced_query, history) or "general"
        except Exception as e:
            logger.error(f"Routing error: {str(e)}")
            route = "general"
        
        return {"classification": route, **state}
    
    except Exception as e:
        logger.error(f"Classification error: {str(e)}")
        return {"classification": "general", **state}

def query_database(state: GraphState) -> GraphState:
    try:
        conv_id = state["conversation_id"]
        llm = LLMFactory(config, state["model"]).get_llm()
        results = llm.vector_search(
            state["question"],
            context=get_chat_history(conv_id)
        )
        
        if results:
            add_to_chat_history(conv_id, state["question"], "Database results found")
            return {"response": results, **state}
        return {"classification": "general", **state}
    
    except Exception as e:
        logger.error(f"Database query error: {str(e)}")
        return {"classification": "general", **state}

def code_generation(state: GraphState) -> GraphState:
    try:
        conv_id = state["conversation_id"]
        history = get_chat_history(conv_id)
        
        response = LangGraphAgentHandler.generate_code(
            state["question"],
            chat_history=history,
            model_config=model_config[state["model"]]
        )
        add_to_chat_history(conv_id, state["question"], response)
        return {"response": response, "reference": ["Generated Code"], **state}
    
    except Exception as e:
        logger.error(f"Code generation error: {str(e)}")
        return {"response": f"Error: {str(e)}", **state}

def jira_code_generation(state: GraphState) -> GraphState:
    try:
        conv_id = state["conversation_id"]
        jira_details = LangGraphAgentHandler.extract_jira_pattern(state["question"])
        response = LangGraphAgentHandler.generate_code(
            jira_prompt_code_gen_prompt(jira_details),
            chat_history=get_chat_history(conv_id),
            model_config=model_config[state["model"]]
        )
        add_to_chat_history(conv_id, state["question"], response)
        return {"response": response, "reference": ["JIRA Code"], **state}
    
    except Exception as e:
        logger.error(f"JIRA code error: {str(e)}")
        return {"response": f"JIRA Error: {str(e)}", **state}

def answer_user(state: GraphState) -> GraphState:
    if "response" in state:
        add_to_chat_history(
            state["conversation_id"],
            state["question"],
            state["response"]
        )
    return state

# Workflow configuration
workflow.add_node("classify_query", classify_query)
workflow.add_node("query_database", query_database)
workflow.add_node("code_generation", code_generation)
workflow.add_node("jira_code_generation", jira_code_generation)
workflow.add_node("answer_user", answer_user)

workflow.add_conditional_edges(
    "classify_query",
    lambda state: state.get("classification", "general"),
    {
        "jira_code_generation": "jira_code_generation",
        "code_generation": "code_generation",
        "document": "query_database",
        "confluence": "query_database",
        "general": "query_database"
    }
)

workflow.add_edge("jira_code_generation", "answer_user")
workflow.add_edge("code_generation", "answer_user")
workflow.add_edge("query_database", "answer_user")
workflow.add_edge("answer_user", END)

workflow.set_entry_point("classify_query")
compiled_workflow = workflow.compile()

def ask_question(query: str, user_id: str, conversation_id: str, model: str) -> Dict:
    try:
        initial_state = {
            "question": query,
            "user_id": user_id,
            "conversation_id": conversation_id,
            "model": model,
            "classification": None,
            "response": None
        }
        
        result = compiled_workflow.invoke(initial_state)
        
        return {
            "response": result.get("response"),
            "classification": result.get("classification"),
            "history": get_chat_history(conversation_id)[-3:]
        }
    
    except Exception as e:
        logger.error(f"Ask question error: {str(e)}")
        add_to_chat_history(conversation_id, query, f"System Error: {str(e)}")
        return {
            "error": "Internal server error",
            "details": str(e)
        }
