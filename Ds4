import pandas as pd
import plotly.graph_objects as go
import numpy as np
import plotly.express as px

# Sample data preparation (replace with your actual DataFrame)
data = {
    'Sender': ['Stable Bank Zamba Ltd.', 'FirstBank Bank Limited', 'Commonwealth Bank of Australia', 'LUOIDS'] * 25,
    'Converting Agent': ['LUOIDS', 'CUA DE ANDROSO DE POLLENSA', 'Commonwealth Bank of Australia', 'FirstBank Bank Limited'] * 25,
    'Creditor Bank': ['CUA DE ANDROSO DE POLLENSA', 'LUOIDS', 'Stable Bank Zamba Ltd.', 'Commonwealth Bank of Australia'] * 25
}
df_converted_after = pd.DataFrame(data)

# Get top 10 values for each column
top_10_sender = df_converted_after['Sender'].value_counts().nlargest(10).index.tolist()
top_10_converting = df_converted_after['Converting Agent'].value_counts().nlargest(10).index.tolist()
top_10_creditor = df_converted_after['Creditor Bank'].value_counts().nlargest(10).index.tolist()

# Filter DataFrame to include only top 10 entries
filtered = df_converted_after[
    df_converted_after['Sender'].isin(top_10_sender) &
    df_converted_after['Converting Agent'].isin(top_10_converting) &
    df_converted_after['Creditor Bank'].isin(top_10_creditor)
]

# Create node labels
node_labels = top_10_sender + top_10_converting + top_10_creditor

# Create dictionaries for node positions
sender_dict = {name: i for i, name in enumerate(top_10_sender)}
converting_dict = {name: i + len(top_10_sender) for i, name in enumerate(top_10_converting)}
creditor_dict = {name: i + len(top_10_sender) + len(top_10_converting) for i, name in enumerate(top_10_creditor)}

# Prepare link data
links = []

# Sender -> Converting Agent flows
sender_converting = filtered.groupby(['Sender', 'Converting Agent']).size().reset_index(name='count')
for _, row in sender_converting.iterrows():
    links.append({
        'source': sender_dict[row['Sender']],
        'target': converting_dict[row['Converting Agent']],
        'value': row['count']
    })

# Converting Agent -> Creditor Bank flows
converting_creditor = filtered.groupby(['Converting Agent', 'Creditor Bank']).size().reset_index(name='count')
for _, row in converting_creditor.iterrows():
    links.append({
        'source': converting_dict[row['Converting Agent']],
        'target': creditor_dict[row['Creditor Bank']],
        'value': row['count']
    })

# Enterprise color scheme (IBM Carbon Design System inspired)
sender_colors = [
    "#0f62fe", "#0043ce", "#002d9c", "#001d6c", 
    "#001141", "#0000b3", "#000091", "#000070", 
    "#000050", "#000030"
]
converting_colors = [
    "#24a148", "#198038", "#10642a", "#0c4e20", 
    "#083816", "#05642a", "#045820", "#034d16", 
    "#023d0d", "#012d06"
]
creditor_colors = [
    "#ff832b", "#fa6800", "#cc5800", "#a34e00", 
    "#7c3c00", "#ff9d5c", "#ff8c3a", "#ff7a18", 
    "#e65c00", "#c54e00"
]
node_colors = sender_colors + converting_colors + creditor_colors

# Calculate vertical positions with increased spacing for Converting Agents
def calculate_positions(n, offset=0, spacing_factor=1.0):
    """Calculate positions with adjustable spacing"""
    max_val = max(1, n - 1) * spacing_factor
    return [offset + i * spacing_factor / max_val for i in range(n)]

# Positions with increased spacing for Converting Agents
y_sender = calculate_positions(len(top_10_sender), spacing_factor=1.0)
y_converting = calculate_positions(len(top_10_converting), spacing_factor=1.5)  # 50% more spacing
y_creditor = calculate_positions(len(top_10_creditor), spacing_factor=1.0)

# Combine all y positions
y_positions = y_sender + y_converting + y_creditor

# Create Sankey diagram with vertical orientation
fig = go.Figure(go.Sankey(
    node=dict(
        pad=40,  # Increased padding
        thickness=20,
        line=dict(color="black", width=0.8),
        label=node_labels,
        color=node_colors,
        x=[0] * len(top_10_sender) + [0.5] * len(top_10_converting) + [1] * len(top_10_creditor),
        y=y_positions,
        hovertemplate='%{label}<br>Count: %{value}<extra></extra>'
    ),
    link=dict(
        source=[link['source'] for link in links],
        target=[link['target'] for link in links],
        value=[link['value'] for link in links],
        color="rgba(100, 100, 100, 0.2)",  # Subtle gray
        hoverinfo='all'
    ),
    arrangement="freeform",
    orientation="h"
))

# Update layout with professional styling
fig.update_layout(
    title=dict(
        text='Payment Flow Analysis: Sender → Converting Agent → Creditor Bank',
        x=0.5,
        y=0.97,
        xanchor='center',
        font=dict(size=22, family="Arial", color="#161616")
    ),
    font=dict(size=12, family="Arial", color="#525252"),
    height=900,
    width=1100,
    xaxis=dict(showgrid=False, zeroline=False, visible=False),
    yaxis=dict(showgrid=False, zeroline=False, visible=False),
    plot_bgcolor='white',
    paper_bgcolor='white',
    margin=dict(t=120, b=40, l=40, r=40),
    annotations=[
        dict(
            x=0,
            y=1.08,
            xref='paper',
            yref='paper',
            text='SENDERS',
            showarrow=False,
            font=dict(size=16, color="#0f62fe")
        ),
        dict(
            x=0.5,
            y=1.08,
            xref='paper',
            yref='paper',
            text='CONVERTING AGENTS',
            showarrow=False,
            font=dict(size=16, color="#24a148")
        ),
        dict(
            x=1,
            y=1.08,
            xref='paper',
            yref='paper',
            text='CREDITOR BANKS',
            showarrow=False,
            font=dict(size=16, color="#ff832b")
        ),
        dict(
            x=0.5,
            y=1.13,
            xref='paper',
            yref='paper',
            text='Transaction Flow Analysis (Top 10 Entities)',
            showarrow=False,
            font=dict(size=18, color="#393939")
        )
    ]
)

# Add data source footnote
fig.add_annotation(
    x=1, y=-0.08,
    xref='paper', yref='paper',
    text="Data Source: Enterprise Transaction System",
    showarrow=False,
    font=dict(size=12, color="#8a8a8a"),
    align="right"
)

fig.show()
